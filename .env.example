# AI 提供方：openai（默认，兼容 DeepSeek 等第三方 API）、gemini 或 deepseek
# - openai: 使用 OPENAI_API_KEY + OPENAI_MODEL，设置 OPENAI_BASE_URL 可指向第三方 API
# - gemini: 使用 GEMINI_API_KEY + GEMINI_MODEL
# - deepseek: 等同于 openai 模式，内部走 Chat Completions API
AI_PROVIDER=openai

# DeepSeek 通过 SiliconFlow / 第三方 API（推荐，AI_PROVIDER=openai）
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Pro
# OPENAI_API_KEY=your_siliconflow_api_key_here

# DeepSeek 原生 API（AI_PROVIDER=deepseek 时使用）
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash
# OPENAI_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_THINKING=disabled

# 单次任务并行分析文章数（建议 2-3，最高限制为 6）
AI_ANALYSIS_WORKERS=3

# OpenAI 原生 API 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini API 配置（AI_PROVIDER=gemini 时使用）
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# 新闻质量评分（v1 版本，纯算法 + AI 增强）
# 评分维度：来源权威度、关键词匹配、信息密度、数据含量、时效性、
#           标题正文一致性、原创性、完整性、透明度（后四项依赖 AI 分析）
# 评分规则版本化，使用缓存避免重复评分
NEWS_QUALITY_SCORING_ENABLED=true

# Agent 与本地存储配置
DATABASE_PATH=data/industry_news.db
TOPICS_XLSX_PATH=复星旅文DeepResearch研究主题目录_更新版_V4.xlsx
DEPLOYMENT_MODE=local

# 独立定时 worker 每隔多少分钟扫描到期主题
SCHEDULER_POLL_MINUTES=30
MAX_TOPICS_PER_CYCLE=2
TZ=Asia/Shanghai
